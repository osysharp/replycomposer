// THE COMPOSER ON SCREEN — driven as staff drive it: empty, drafting with the formatting bar, a saved reply inserted
// and filled, a macro applied with its steps waiting, a file added — at phone and wide, light and dark. `osy test
// --pixels` photographs each (`Ui.Shot`).
using Osysharp.Identity;
using Osysharp.ReplyComposer;
using ComposerKitTests;

/// The replies and the macro a building desk keeps.
void Library() {
  runas (Ada) {
    SaveSavedReply(null, "", "Radiator — fitter booked",
      "Hi {{tenant.first_name}},\n\nA fitter will come to flat {{request.unit}} tomorrow between **8 and 10**. Before then:\n\n- clear the space under the window\n- leave the heating on\n\nThanks,", "Heating", true);
    SaveSavedReply(null, "", "Lift — engineer called", "Hi {{tenant.first_name}},\n\nThe lift engineer is on the way.", "Lift", true);
    SaveSavedReply(null, "", "Keys — collect at reception", "Your new keys are at reception from 9.", "Keys", true);
    SaveMacro(null, "", "Fixed — mark it done", "Heating",
      "Hi {{tenant.first_name}}, that is fixed now — tell us if it comes back.", false, true,
      [new StagedStep { Action = "ComposerKitTests.LabelRequest", Parameter = "label", Choice = "heating" }, new StagedStep { Action = "ComposerKitTests.SetRequestStatus", Parameter = "status", Choice = "Done" }]);
  }
}

[Test(Building)]
void the_composer_empty_drafting_a_saved_reply_a_macro_and_a_file() {
  Library();
  Ui.Viewport(1440, 900);
  Ui.SignInAs(Ada);
  Ui.Visit("/request/101");
  // EMPTY — the mode and who reads it, the bar, the box, the actions; nothing saved yet, so nothing says so.
  Assert.Visible("To Hanna Svensson · by mail", within: "Composer");
  Assert.Hidden("Draft saved");
  Assert.Visible("Signed", within: "Composer");
  Ui.Shot("composer-empty-wide-light");
  Ui.Theme("dark");
  Ui.Shot("composer-empty-wide-dark");
  Ui.Theme("light");

  // DRAFTING — the bar acts on the line the cursor is on.
  Ui.Fill("Reply", "Thanks for telling us. Before the fitter comes:\nclear the space under the window");
  Ui.Click("Bulleted list");
  Assert.Value("Reply", "Thanks for telling us. Before the fitter comes:\n- clear the space under the window");
  Ui.Shot("composer-drafting-wide-light");

  // A SAVED REPLY — searched, inserted where the cursor is, filled from the request.
  Ui.Fill("Reply", "");
  Ui.Click("Saved replies");
  Ui.Fill("Search saved replies", "fitter");
  Assert.Hidden("Lift — engineer called");
  Ui.Shot("composer-saved-reply-picker-wide-light");
  Ui.Click("Radiator — fitter booked");
  Assert.Value("Reply", "Hi Hanna,\n\nA fitter will come to flat 4B tomorrow between **8 and 10**. Before then:\n\n- clear the space under the window\n- leave the heating on\n\nThanks,");
  Ui.Shot("composer-saved-reply-wide-light");
  Ui.Click("Preview");
  Assert.Visible("8 and 10", within: "Preview");
  Ui.Shot("composer-preview-wide-light");
  Ui.Theme("dark");
  Ui.Shot("composer-preview-wide-dark");
  Ui.Theme("light");
  Ui.Click("Write");

  // A MACRO — its reply goes in, its steps wait for the send.
  Ui.Fill("Reply", "");
  Ui.Click("Macros");
  Ui.Click("Fixed — mark it done");
  Assert.Visible("When you send:", within: "Composer");
  Assert.Visible("Set status: Done", within: "Steps when you send");
  Ui.Shot("composer-macro-wide-light");

  // A FILE — dropped on the composer, listed with its size.
  Ui.Upload("Composer", "boiler-pressure.txt", "pressure 0.4 bar at 08:10\npressure 0.3 bar at 08:40\n");
  Assert.Visible("boiler-pressure.txt", within: "Files to send");
  Ui.Shot("composer-file-wide-light");
  Ui.Theme("dark");
  Ui.Shot("composer-file-wide-dark");
  Ui.Theme("light");

  // SENT — the reply, signed, with its file; the steps ran; the composer is empty again and says what happened.
  Ui.Click("Send");
  Assert.Visible("that is fixed now", within: "Replies");
  Assert.Visible("Facilities, Kestrel House", within: "Replies");
  Assert.Visible("Status set to Done.", within: "Composer");
  runas (Ada) {
    var r = Request.Single(x => x.Number == 101);
    Assert.Equal(RequestStatus.Done, r.Status);
    Assert.Equal("heating", r.Labels);
    Assert.Equal(1, RequestReply.Single().Files);
    Assert.Equal(0, ComposerDraft.Count());
  }
}

[Test(Building)]
void on_a_phone_the_composer_keeps_its_bar_and_its_actions_on_the_screen() {
  Library();
  Ui.Viewport(390, 844);
  Ui.SignInAs(Ada);
  Ui.Visit("/request/101");
  Assert.NoOverflow();
  Assert.Clickable("Send");
  Ui.Shot("composer-empty-phone-light");
  Ui.Click("Macros");
  Ui.Click("Fixed — mark it done");
  Ui.Upload("Composer", "boiler-pressure.txt", "pressure 0.4 bar\n");
  Assert.NoOverflow();
  Assert.Clickable("Send");
  Ui.Shot("composer-macro-file-phone-light");
  Ui.Theme("dark");
  Ui.Shot("composer-macro-file-phone-dark");
}

[Test(Building)]
void a_draft_survives_a_reload_and_discard_can_be_undone() {
  Ui.SignInAs(Raj);
  Ui.Visit("/request/102");
  Ui.Fill("Reply", "The engineer is booked for 14:00 — I will be there too.");
  Ui.AwaitChange(Osysharp.ReplyComposer.ComposerDraft);
  Ui.Visit("/request/102");
  Assert.Value("Reply", "The engineer is booked for 14:00 — I will be there too.");
  Assert.Visible("Draft saved", within: "Composer");
  Ui.Click("Discard");
  Assert.Value("Reply", "");
  Assert.Visible("Draft discarded.", within: "Composer");
  Ui.Click("Undo");
  Assert.Value("Reply", "The engineer is booked for 14:00 — I will be there too.");
}

[Test(Building)]
void the_keys_switch_the_mode_and_open_the_macros_and_the_sheet_lists_them() {
  Library();
  Ui.SignInAs(Ada);
  Ui.Visit("/request/101");
  Ui.Press("N");
  Assert.Visible("Only the team sees this.", within: "Composer");
  Assert.Focused("Internal note");
  Assert.Visible("Add note", within: "Composer");
  // A bare key is text while the cursor is in the box — so each next key is pressed from a fresh page.
  Ui.Visit("/request/101");
  Ui.Press("R");
  Assert.Visible("Send", within: "Composer");
  Assert.Focused("Reply");
  Assert.Hidden("Only the team sees this.");
  Ui.Visit("/request/101");
  Ui.Press("Shift+M");
  Assert.Visible("Fixed — mark it done");
  Ui.Press("Escape");
  Ui.Press("?");
  Assert.Visible("Internal note", within: "Keyboard shortcuts");
  Assert.Visible("Macros", within: "Keyboard shortcuts");
}

[Test(Building)]
void the_settings_refuse_a_placeholder_nobody_declared_and_insert_a_declared_one() {
  Ui.Viewport(1280, 900);
  Ui.SignInAs(Ada);
  Ui.Visit("/settings/replies");
  Assert.Visible("No saved replies yet");
  Ui.Click("Add a reply");
  Ui.Fill("Title", "Heating — on our way");
  Ui.Fill("Reply", "Hi {{tenant.firstname}}, we are on our way.");
  Ui.Click("Save");
  Assert.Visible("{{tenant.firstname}} is not a placeholder");
  Ui.Shot("settings-reply-refused-wide-light");
  Ui.Fill("Reply", "Hi , we are on our way.");
  Ui.Click("Insert a placeholder");
  Ui.Click("Tenant's first name  {{tenant.first_name}}");
  Ui.Click("Save");
  Assert.Visible("Heating — on our way", within: "Every saved reply");
  Ui.Visit("/settings/macros");
  Ui.Click("Add a macro");
  Ui.Fill("Title", "Waiting on the tenant");
  Ui.Click("Add a step");
  Ui.Click("Set status");
  Ui.Click("Waiting on the tenant");
  Assert.Visible("Set status: Waiting on the tenant", within: "Steps");
  Ui.Shot("settings-macro-wide-light");
  Ui.Click("Save");
  Assert.Visible("Set status: Waiting on the tenant", within: "Every macro");
}

// ── ⭐ A MACRO STEP THAT TAKES A DATE, A NUMBER AND A LIST is set up in a form, each value in the input its kind takes.
[Test(Building)]
void a_macro_step_that_takes_a_date_a_number_and_a_list_is_set_up_in_a_form() {
  Ui.Viewport(1440, 900);
  Ui.SignInAs(Ada);
  Ui.Visit("/settings/macros");
  Ui.Click("Add a macro");
  Ui.Fill("Title", "Visit booked");
  Ui.Click("Add a step");
  Ui.Click("Promise a visit");
  Assert.Visible("A whole number.");
  Assert.Visible("Several values, written as a JSON list.");
  Ui.Fill("On", "2026-11-02");
  Ui.Fill("Hours", "3");
  Ui.Fill("Bring", "ladder");
  Ui.Click("Add the step");
  Assert.Visible("Bring is not written as it should be");
  Ui.Fill("Bring", "[\"ladder\"]");
  Ui.Click("Add the step");
  Assert.Visible("Promise a visit: 2026-11-02, 3, ladder", within: "Steps");
  Ui.Shot("settings-macro-form-step-wide-light");
  Ui.Click("Save");
  Assert.Visible("Promise a visit: 2026-11-02, 3, ladder", within: "Every macro");
}
